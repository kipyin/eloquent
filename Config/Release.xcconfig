// Release defaults. Local `CONFIG=Release make run` stays unsigned unless
// DEVELOPMENT_TEAM is passed on the xcodebuild command line (Makefile) or a
// gitignored overlay is present.
//
// Xcode Cloud Archive: ci_pre_xcodebuild.sh writes Release-Signing.xcconfig
// from DEVELOPMENT_TEAM when that env var is set. Do not put a Team ID here.
// Cloud also passes CODE_SIGN_IDENTITY=- on the xcodebuild command line, which
// overrides any identity in that overlay. ci_post stamps the team before
// Developer ID export. See docs/release.md.

ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_STYLE = Automatic

#include? "Release-Signing.xcconfig"
